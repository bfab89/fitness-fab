{
  "expo": {
    "name": "FitnessFab",
    "slug": "fitness-fab",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitnessfab.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "FitnessFab reads your health data to provide personalized workout and nutrition recommendations.",
        "NSHealthUpdateUsageDescription": "FitnessFab writes workout data to Apple Health to keep your fitness history up to date."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.fitnessfab.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS"
      ]
    },
    "web": {},
    "scheme": "fitnessfab",
    "extra": {
      "pelotonClientId": "",
      "myNetDiaryClientId": "",
      "myNetDiaryClientSecret": ""
    }
  }
}
